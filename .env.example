# Скопируйте в .env и заполните, когда создадите проект Supabase.
# Без этих значений приложение работает в локальном демо-режиме (данные в браузере).

# URL проекта Supabase (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=
# anon/public ключ из Supabase → Settings → API
VITE_SUPABASE_ANON_KEY=
# URL функции аутентификации (см. supabase/functions/telegram-auth/README)
VITE_SUPABASE_FUNCTION_URL=